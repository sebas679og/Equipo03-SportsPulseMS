# Global Configurations
SPORTS_PULSE_LEVEL_LOGIN=DEBUG

# Database Configurations
SPORTS_PULSE_DATASOURCE_USERNAME=sports_pulse_user
SPORTS_PULSE_DATASOURCE_PASSWORD=sports_pulse_password

# JPA Configurations
SPORTS_PULSE_JPA_DDL=update
SPORTS_PULSE_JPA_SHOW_SQL=true

# Swagger Configurations
SWAGGER_UI_DOCUMENTATION_ENABLED=true

# Sports Pulse Service Auth
SPORTS_PULSE_DATASOURCE_URL_AUTH=jdbc:postgresql://localhost:5432/sports_pulse_auth_db
SPORTS_PULSE_DATASOURCE_DB_AUTH=sports_pulse_auth_db

# Sports Pulse Service Notifications
SPORTS_PULSE_DATASOURCE_URL_NOIFICATIONS=jdbc:postgresql://localhost:5432/sports_pulse_notifications_db
SPORTS_PULSE_DATASOURCE_DB_NOIFICATIONS=sports_pulse_notifications_db

# Sports Pulse URL Services
AUTH_SERVICE_URL: http://localhost:8081
LEAGUES_SERVICE_URL: http://localhost:8082
TEAMS_SERVICE_URL: http://localhost:8083
FIXTURES_SERVICE_URL: http://localhost:8085
STANDINGS_SERVICE_URL: http://localhost:8086
NOTIFICATIONS_SERVICE_URL: http://localhost:8088
DASHBOARD_SERVICE_URL: http://localhost:8089